{
  "app": {
    "products": [
      {
        "name": "default",
        "compileSdkVersion": "26.0.1",
        "compatibleSdkVersion": "26.0.1",
        "runtimeOS": "OpenHarmony",
        "targetSdkVersion": "26.0.1"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
