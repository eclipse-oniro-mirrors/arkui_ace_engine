import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

jsi_class_base_sources = [
  "$ace_root/frameworks/bridge/declarative_frontend/engine/jsi/jsi_class_base.cpp",
  "jsi_class_base_test.cpp",
]

jsi_constructor_binding_sources = [
  "$ace_root/frameworks/bridge/declarative_frontend/engine/jsi/jsi_class_base.cpp",
  "jsi_constructor_binding_test.cpp",
]

if (is_host_product) {
  ace_unittest("jsi_class_base_test") {
    type = "host_components"
    module_name = "Bridge-JsiClassBase"
    defines = [ "USE_ARK_ENGINE" ]
    external_deps = [
      "ets_runtime:libark_jsruntime",
      "libuv:uv",
      "napi:ace_napi",
      "node:node_header_notice",
    ]
    sources = jsi_class_base_sources
  }
  ace_unittest("jsi_constructor_binding_test") {
    type = "host_components"
    module_name = "Bridge-JsiConstructorBinding"
    defines = [ "USE_ARK_ENGINE" ]
    external_deps = [
      "ets_runtime:libark_jsruntime",
      "libuv:uv",
      "napi:ace_napi",
      "node:node_header_notice",
    ]
    sources = jsi_constructor_binding_sources
  }
} else {
  ace_unittest("jsi_class_base_test") {
    type = "new"
    module_name = "Bridge-JsiClassBase"
    defines = [ "USE_ARK_ENGINE" ]
    external_deps = [
      "ets_runtime:libark_jsruntime",
      "libuv:uv",
      "napi:ace_napi",
      "node:node_header_notice",
    ]
    sources = jsi_class_base_sources
  }
  ace_unittest("jsi_constructor_binding_test") {
    type = "new"
    module_name = "Bridge-JsiConstructorBinding"
    defines = [ "USE_ARK_ENGINE" ]
    external_deps = [
      "ets_runtime:libark_jsruntime",
      "libuv:uv",
      "napi:ace_napi",
      "node:node_header_notice",
    ]
    sources = jsi_constructor_binding_sources
  }
}
