import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

# Compile the original public error getter without the unrelated node utilities.
action("interaction_observer_error_getter") {
  testonly = true
  script = "../extract_page_text_error_getter.py"
  inputs = [ "$ace_root/interfaces/native/node/node_utils.cpp" ]
  outputs = [ "$target_gen_dir/interaction_observer_error_getter.cpp" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

# Keep the framework bridge and NodeModel stubs local to this executable: the
# interaction observer API table is provided by the test itself, mirroring how
# the production NDK layer resolves it through dlsym.
ace_unittest("capi_interaction_observer_test") {
  module_name = "C-API-Main"
  type = "new"
  sources = [
    "$ace_root/frameworks/base/json/json_util.cpp",
    "$ace_root/frameworks/core/components_ng/base/inspector_filter.cpp",
    "$ace_root/frameworks/core/components_ng/manager/interaction_observer/ui_interaction_json_builder.cpp",
    "$ace_root/frameworks/core/interfaces/native/utility/error_message_manager.cpp",
    "$ace_root/interfaces/native/native_error_message_wrapper.cpp",
    "$ace_root/interfaces/native/ui_info_collection.cpp",
    "$ace_root/interfaces/native/ui_json_wrapper.cpp",
    "../interaction_observer_capi_test.cpp",
  ]
  sources += get_target_outputs(":interaction_observer_error_getter")
  extra_deps = []
  extra_deps += [ ":interaction_observer_error_getter" ]
  include_dirs = [
    "$ace_root",
    "$ace_root/frameworks",
    "$ace_root/interfaces/native",
    "$ace_root/interfaces/inner_api/ace_kit/include",
  ]
  external_deps = [
    "bounds_checking_function:libsec_static",
    "cJSON:cjson",
  ]
  defines = [ "ARKUI_CAPI_UNITTEST" ]
}
