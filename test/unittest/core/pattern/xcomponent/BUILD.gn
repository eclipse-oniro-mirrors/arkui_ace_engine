import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

ace_unittest("xcomponent_test_ng") {
  module_name = "DrawingSet-Path"
  type = "new"
  if (is_host_product) {
    type = "host_components"
  }
  sources = [
    "$ace_root/frameworks/core/components/xcomponent/native_interface_xcomponent_impl.cpp",
    "$ace_root/frameworks/core/components_ng/pattern/custom_frame_node/custom_accessibility_child_tree_callback.cpp",
    "$ace_root/frameworks/core/components_ng/pattern/custom_frame_node/custom_accessibility_provider.cpp",
    "$ace_root/frameworks/core/components_ng/pattern/custom_frame_node/custom_accessibility_session_adapter.cpp",
    "$ace_root/frameworks/core/components_ng/pattern/custom_frame_node/custom_pattern.cpp",
    "$ace_root/frameworks/core/components_ng/pattern/xcomponent/xcomponent_resolution_config.cpp",
    "$ace_root/frameworks/core/interfaces/native/node/node_xcomponent_modifier.cpp",
    "xcomponent_layout_test_ng.cpp",
    "xcomponent_inspector_tree_test_ng.cpp",
    "xcomponent_pattern_branch_test.cpp",
    "xcomponent_property_test_ng.cpp",
    "xcomponent_property_test_two_ng.cpp",
    "xcomponent_static_test_ng.cpp",
    "xcomponent_test_buffer_queue_count.cpp",
    "xcomponent_test_ng.cpp",
    "xcomponent_test_three_ng.cpp",
    "xcomponent_testtwo_ng.cpp",
    "xcomponent_utils_test_ng.cpp",
    "xcomponent_v2_test_ng.cpp",
  ]

  if (!ace_enable_full_test_suite) {
    sources = []
    sources = [ "xcomponent_test_core.cpp" ]
  } else {
    sources += [ "xcomponent_test_core.cpp" ]
  }

  if (!is_host_product) {
    external_deps = [
      "bounds_checking_function:libsec_shared",
      "napi:ace_napi",
    ]
  }
}

ace_unittest("xcomponent_test_set_rate_range") {
  module_name = "CommonEvent-VisiableAreaChange"
  type = "new"
  if (is_host_product) {
    type = "host_components"
  }

  sources = [
    "$ace_root/frameworks/core/components/xcomponent/native_interface_xcomponent_impl.cpp",
    "xcomponent_test_set_rate_range.cpp",
  ]

  if (!ace_enable_full_test_suite) {
    sources = []
    sources = [ "xcomponent_test_set_rate_range_core.cpp" ]
  } else {
    sources += [ "xcomponent_test_set_rate_range_core.cpp" ]
  }

  defines = [ "ENABLE_ROSEN_BACKEND" ]
  if (!is_host_product) {
    external_deps = [ "bounds_checking_function:libsec_shared" ]
    if (current_os == "ohos") {
      external_deps += [ "napi:ace_napi" ]
    }
  }
}

