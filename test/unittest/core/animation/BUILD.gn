import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

test_sources = [ "geometry_transition_test_ng.cpp" ]

animation_group_sources = [
  "$ace_root/frameworks/core/components_ng/animation/animation_group_adapter.cpp",
  "animation_group_adapter_test.cpp",
  "animation_group_animation_utils_mock.cpp",
]

core_min_sources = [
  "animation_test_min.cpp",
  "animation_test_core.cpp",
]

if (is_host_product) {
  ace_unittest("geometry_transition_test_ng") {
    type = "host_components"
    module_name = "Animation-GeometryTransition"
    sources = test_sources + core_min_sources
  }
} else {
  ace_unittest("geometry_transition_test_ng") {
    module_name = "Animation-GeometryTransition"
    type = "new"
    sources = test_sources
    if (!ace_enable_full_test_suite) {
      sources = []
      sources = core_min_sources
    } else {
      sources += core_min_sources
    }
  }
}

if (is_host_product) {
  ace_unittest("callback_thread_wrapper_test") {
    type = "host_components"
    module_name = "ScrollingSet-Refresh"
    sources = [
      "$ace_root/frameworks/core/animation/animation_pub.cpp",
      "animation_pub_test.cpp",
      "callback_thread_wrapper_test.cpp",
      "animation_test_min.cpp",
    ]
  }
} else {
  ace_unittest("callback_thread_wrapper_test") {
    module_name = "ScrollingSet-Refresh"
    type = "new"
    sources = [
      "$ace_root/frameworks/core/animation/animation_pub.cpp",
      "animation_pub_test.cpp",
      "callback_thread_wrapper_test.cpp",
    ]

    if (!ace_enable_full_test_suite) {
      sources = []
      sources = [ "animation_test_min.cpp" ]
    } else {
      sources += [ "animation_test_min.cpp" ]
    }
  }
}

if (is_host_product) {
  ace_unittest("animation_group_adapter_test") {
    type = "host_components"
    module_name = "Animation-Animatable"
    sources = animation_group_sources
    cflags = [ "-fno-access-control" ]
    external_deps = [ "hilog:libhilog" ]
  }
} else {
  ace_unittest("animation_group_adapter_test") {
    module_name = "Animation-Animatable"
    type = "new"
    sources = animation_group_sources
    cflags = [ "-fno-access-control" ]
    external_deps = [ "hilog:libhilog" ]
  }
}

group("core_animation_unittest") {
  testonly = true
  deps = [
    ":animation_group_adapter_test",
    ":callback_thread_wrapper_test",
    ":geometry_transition_test_ng",
  ]
}
