+/**
+ * @tc.name: ParseSweepGradientCoverageTest003
+ * @tc.desc: ParseSweepGradient invalid-field branches (center / angles / repeating).
+ * @tc.type: FUNC
+ */
+TEST(SweepRadialGradientCoverageTest, ParseSweepGradientCoverageTest003)
+{
+    StyleSweepGradient gradient;
+
+    // center not an array -> hasInvalidField
+    auto centerNotArray = ParseRoot(R"({"center":"50","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(centerNotArray, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // center array size < 2 -> hasInvalidField
+    auto centerShort = ParseRoot(R"({"center":[50],"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(centerShort, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // center array with invalid items -> hasInvalidField
+    auto centerBad = ParseRoot(R"({"center":["abc","def"],"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(centerBad, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // start invalid (string) -> hasInvalidField
+    auto startBad = ParseRoot(R"({"start":"abc","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(startBad, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // end invalid -> hasInvalidField
+    auto endBad = ParseRoot(R"({"end":"x","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(endBad, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // rotation invalid -> hasInvalidField
+    auto rotBad = ParseRoot(R"({"rotation":"x","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(rotBad, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // repeating string "true" -> repeating true, no invalid
+    auto repStrTrue = ParseRoot(R"({"repeating":"true","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(repStrTrue, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_TRUE(gradient.repeating);
+
+    // repeating string "false" -> repeating false, no invalid
+    auto repStrFalse = ParseRoot(R"({"repeating":"false","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(repStrFalse, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FALSE(gradient.repeating);
+
+    // repeating string other -> hasInvalidField
+    auto repStrOther = ParseRoot(R"({"repeating":"yes","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(repStrOther, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // repeating non-bool non-string (number) -> hasInvalidField
+    auto repNumber = ParseRoot(R"({"repeating":1,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(repNumber, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // repeating bool false explicit -> no invalid
+    auto repBool = ParseRoot(R"({"repeating":false,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(repBool, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FALSE(gradient.repeating);
+
+    // colors not an array -> false (early return)
+    auto colorsNotArray = ParseRoot(R"({"colors":"red"})");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(colorsNotArray, gradient));
+
+    // colors missing entirely (GetItem on absent key) -> not array -> false
+    auto noColors = ParseRoot(R"({"center":["50","50"]})");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(noColors, gradient));
+}
