+/**
+ * @tc.name: ParseRadialGradientCoverageTest001
+ * @tc.desc: ParseRadialGradient top-level rejection + valid shapes + radius branches.
+ * @tc.type: FUNC
+ */
+TEST(SweepRadialGradientCoverageTest, ParseRadialGradientCoverageTest001)
+{
+    StyleRadialGradient gradient;
+
+    // non-object -> false
+    auto notObject = ParseRoot(R"("x")");
+    EXPECT_FALSE(StyleApplyUtils::ParseRadialGradient(notObject, gradient));
+
+    // has "path" -> false
+    auto hasPath = ParseRoot(R"({"path":"x","colors":["#FF0000"]})");
+    EXPECT_FALSE(StyleApplyUtils::ParseRadialGradient(hasPath, gradient));
+
+    // has "call" -> false
+    auto hasCall = ParseRoot(R"({"call":"x","colors":["#FF0000"]})");
+    EXPECT_FALSE(StyleApplyUtils::ParseRadialGradient(hasCall, gradient));
+
+    // minimal valid: only colors -> true
+    auto minimal = ParseRoot(R"({"colors":["#FF0000","#00FF00"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(minimal, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_EQ(gradient.colors.size(), 2U);
+    EXPECT_FLOAT_EQ(gradient.radius, 0.0F); // default retained
+
+    // full valid with px center + radius + bool repeating
+    auto full = ParseRoot(R"({"center":["50px","50px"],"radius":100,
+        "repeating":true,"colors":["#FF0000","#00FF00"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(full, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.centerX, 50.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 50.0F);
+    EXPECT_FLOAT_EQ(gradient.radius, 100.0F);
+    EXPECT_TRUE(gradient.repeating);
+
+    // radius = 0 -> valid (>=0 boundary)
+    auto radiusZero = ParseRoot(R"({"radius":0,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(radiusZero, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.radius, 0.0F);
+
+    // radius negative -> hasInvalidField
+    auto radiusNeg = ParseRoot(R"({"radius":-5,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(radiusNeg, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // radius invalid type (string non-numeric) -> hasInvalidField
+    auto radiusBad = ParseRoot(R"({"radius":"abc","colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(radiusBad, gradient));
+    EXPECT_TRUE(gradient.hasInvalidField);
+
+    // center unit variants for radial
+    auto vpCenter = ParseRoot(R"({"center":["10vp","20vp"],"radius":5,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(vpCenter, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.centerX, 10.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 20.0F);
+
+    auto numCenter = ParseRoot(R"({"center":[10,20],"radius":5,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(numCenter, gradient));
+    EXPECT_FLOAT_EQ(gradient.centerX, 10.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 20.0F);
+
+    auto fpCenter = ParseRoot(R"({"center":["30fp","40fp"],"radius":5,"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseRadialGradient(fpCenter, gradient));
+    EXPECT_FLOAT_EQ(gradient.centerX, 30.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 40.0F);
+}
