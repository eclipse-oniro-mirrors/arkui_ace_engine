+// =============================================================================
+// sweepGradient / radialGradient apply-path coverage (A2UI-sweep-radial-10-26)
+// Covers ApplySweepGradient / ApplyRadialGradient + HasSweepGradientNestedTypeMismatch
+// / ReportSweepGradientParseFailure branches: valid apply, non-object reset,
+// nested type mismatch (parse-succeeds vs parse-fails), INVALID_VALUE fallback.
+// =============================================================================
+
+// Valid sweep gradient -> SetNodeSweepGradient invoked, no issues, no reset.
+TEST_F(ExtendedStyleResolverDfxTest, SweepGradient_Valid_AppliesWithoutIssues)
+{
+    ArkUINodeApiAdapter applier = MakeTestApplier(testNode_);
+    mockArkUIPtr_->setAttributeRecords_.clear();
+    mockArkUIPtr_->resetAttributeRecords_.clear();
+
+    auto styles = JsonAdapter::Parse(
+        R"({"sweepGradient":{"center":["50px","50px"],"start":0,"end":360,"rotation":180,
+        "repeating":true,"colors":["#FF0000","#00FF00"]}})");
+    ASSERT_NE(styles, nullptr);
+    std::vector<DescriptorValidationIssue> issues;
+    ExtendedStyleResolver::ResolveAndApply(styles->GetRoot(), applier, std::nullopt, issues);
