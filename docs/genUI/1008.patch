+/**
+ * @tc.name: ParseSweepGradientCoverageTest001
+ * @tc.desc: ParseSweepGradient top-level rejection (non-object / path / call).
+ * @tc.type: FUNC
+ */
+TEST(SweepRadialGradientCoverageTest, ParseSweepGradientCoverageTest001)
+{
+    StyleSweepGradient gradient;
+
+    // non-object input -> false
+    auto notObject = ParseRoot(R"("not-object")");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(notObject, gradient));
+
+    // array input -> false
+    auto arrayInput = ParseRoot("[1,2,3]");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(arrayInput, gradient));
+
+    // object with "path" -> false (dynamic binding shape)
+    auto hasPath = ParseRoot(R"({"path":"x","colors":["#FF0000"]})");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(hasPath, gradient));
+
+    // object with "call" -> false (function-call shape)
+    auto hasCall = ParseRoot(R"({"call":"x","colors":["#FF0000"]})");
+    EXPECT_FALSE(StyleApplyUtils::ParseSweepGradient(hasCall, gradient));
+}
