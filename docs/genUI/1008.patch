+/**
+ * @tc.name: ParseSweepGradientCoverageTest002
+ * @tc.desc: ParseSweepGradient valid shapes (minimal + full + unit variants).
+ * @tc.type: FUNC
+ */
+TEST(SweepRadialGradientCoverageTest, ParseSweepGradientCoverageTest002)
+{
+    StyleSweepGradient gradient;
+
+    // minimal valid: only colors -> true, all defaults kept
+    auto minimal = ParseRoot(R"({"colors":["#FF0000","#00FF00"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(minimal, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_EQ(gradient.colors.size(), 2U);
+    EXPECT_EQ(gradient.stops.size(), 2U);
+    EXPECT_FLOAT_EQ(gradient.centerX, 50.0F); // default retained
+    EXPECT_FALSE(gradient.repeating);
+
+    // full valid object with px center + all angle fields + bool repeating
+    auto full = ParseRoot(R"({"center":["50px","50px"],"start":0,"end":360,
+        "rotation":180,"repeating":true,"colors":["#FF0000","#00FF00"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(full, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.centerX, 50.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 50.0F);
+    EXPECT_FLOAT_EQ(gradient.start, 0.0F);
+    EXPECT_FLOAT_EQ(gradient.end, 360.0F);
+    EXPECT_FLOAT_EQ(gradient.rotation, 180.0F);
+    EXPECT_TRUE(gradient.repeating);
+
+    // center unit variants: vp / pure number / fp / %
+    auto vpCenter = ParseRoot(R"({"center":["10vp","20vp"],"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(vpCenter, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.centerX, 10.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 20.0F);
+
+    auto numCenter = ParseRoot(R"({"center":[10,20],"colors":["#FF0000"]})");
+    ASSERT_TRUE(StyleApplyUtils::ParseSweepGradient(numCenter, gradient));
+    EXPECT_FALSE(gradient.hasInvalidField);
+    EXPECT_FLOAT_EQ(gradient.centerX, 10.0F);
+    EXPECT_FLOAT_EQ(gradient.centerY, 20.0F);
+
+    auto fpCenter = ParseRoot(R"({"center":["30fp","40fp"],"colors":["#FF0000"]})");
