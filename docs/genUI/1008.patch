+// Branch-coverage tests for the sweep/radial gradient parsing added in
+// A2UI-sweep-radial-10-26. Exercises ParseLength / ParseLengthToken /
+// ParseSweepGradient / ParseRadialGradient so the incremental branch
+// coverage gate (coverage.log) is satisfied for the new C++ style code.
+
+#include <gtest/gtest.h>
+#include <string>
+
+#include "styles/StyleApplyUtils.h"
+#include "utils/JsonAdapter.h"
+
+using namespace NativeModule;
+
+namespace {
+
+// Parse a JSON snippet and return its root JsonValue. Aborts the test on
+// parse failure so each case can assume a valid root.
+JsonValue ParseRoot(const std::string& json)
+{
+    auto adapter = JsonAdapter::Parse(json);
+    EXPECT_NE(adapter, nullptr);
+    return adapter != nullptr ? adapter->GetRoot() : JsonValue();
+}
+
+} // namespace
+
+/**
+ * @tc.name: ParseLengthCoverageTest001
+ * @tc.desc: ParseLength accepts numbers and length strings (vp/px/fp/%/pure),
+ *           rejects invalid / non-string-non-number / empty / bad-suffix.
+ * @tc.type: FUNC
+ */
+TEST(SweepRadialGradientCoverageTest, ParseLengthCoverageTest001)
+{
+    float out = -1.0F;
+
+    // number input -> accepted, value populated
+    auto numberRoot = ParseRoot("120");
+    ASSERT_TRUE(numberRoot.IsValid());
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(numberRoot, out));
+    EXPECT_FLOAT_EQ(out, 120.0F);
+
+    // pure numeric string -> accepted
+    auto pureStr = ParseRoot(R"("50")");
+    ASSERT_TRUE(StyleApplyUtils::ParseLength(pureStr, out));
+    EXPECT_FLOAT_EQ(out, 50.0F);
+
+    // vp suffix -> accepted
+    auto vpStr = ParseRoot(R"("50vp")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(vpStr, out));
+    EXPECT_FLOAT_EQ(out, 50.0F);
+
+    // px suffix -> accepted (new unit support)
+    auto pxStr = ParseRoot(R"("50px")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(pxStr, out));
+    EXPECT_FLOAT_EQ(out, 50.0F);
+
+    // fp suffix -> accepted (new unit support)
+    auto fpStr = ParseRoot(R"("50fp")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(fpStr, out));
+    EXPECT_FLOAT_EQ(out, 50.0F);
+
+    // percent suffix -> accepted
+    auto pctStr = ParseRoot(R"("75%")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(pctStr, out));
+    EXPECT_FLOAT_EQ(out, 75.0F);
+
+    // invalid suffix -> rejected
+    auto badSuffix = ParseRoot(R"("50xyz")");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(badSuffix, out));
+
+    // non-numeric string -> rejected (strtof yields 0, suffix not a unit)
+    auto nonNumeric = ParseRoot(R"("abc")");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(nonNumeric, out));
+
+    // empty string -> rejected
+    auto emptyStr = ParseRoot(R"("")");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(emptyStr, out));
+
+    // non-string, non-number (bool) -> rejected
+    auto boolVal = ParseRoot("true");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(boolVal, out));
+
+    // non-string, non-number (array) -> rejected
+    auto arrayVal = ParseRoot("[1,2]");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(arrayVal, out));
+
+    // non-string, non-number (null) -> rejected
+    auto nullVal = ParseRoot("null");
+    EXPECT_FALSE(StyleApplyUtils::ParseLength(nullVal, out));
+
+    // fractional number string -> accepted
+    auto fracStr = ParseRoot(R"("12.5px")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(fracStr, out));
+    EXPECT_FLOAT_EQ(out, 12.5F);
+
+    // negative number string -> accepted by ParseLengthToken (no sign guard here)
+    auto negStr = ParseRoot(R"("-3vp")");
+    EXPECT_TRUE(StyleApplyUtils::ParseLength(negStr, out));
+    EXPECT_FLOAT_EQ(out, -3.0F);
+}
